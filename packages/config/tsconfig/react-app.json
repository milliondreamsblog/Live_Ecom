{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React App (Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
