CORS_ORIGINS=http://localhost:3000

# MongoDB connection string (required)
# MONGODB_URI=mongodb+srv://user:pass@cluster/live-commerce

# LiveKit (optional) — enables the SFU streaming backend.
# Until these are set, /api/livekit/token returns 501 and the app stays on P2P.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Razorpay (optional) — enables real UPI/card checkout.
# Until these are set, POST /api/orders/:id/pay mock-pays (order -> paid) so
# the dev flow works end to end without charging anyone.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-secret
